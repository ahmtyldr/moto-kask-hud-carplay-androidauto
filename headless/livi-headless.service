[Unit]
Description=LIVI headless projection appliance
Documentation=https://github.com/ahmtyldr/moto-kask-hud-carplay-androidauto
# Deliberately NOT After=network.target: that target waits for NetworkManager,
# which costs ~4 s of a 21 s boot, and this unit does not need it — the Wi-Fi AP
# is brought up by LIVI's own helper (hostapd on wlan0), and the projection
# listeners bind before any phone can answer. Wants= keeps the ordering
# preference without blocking on it, so a wired link still comes up normally.
After=basic.target bluetooth.target
Wants=network.target bluetooth.target

[Service]
Type=simple
User=livi
Group=livi
# Video, DRM and input access; sudo is used internally for the Wi-Fi AP helper.
SupplementaryGroups=video render input plugdev audio bluetooth

WorkingDirectory=/opt/livi
Environment=LIVI_RESOURCES=/opt/livi/resources
Environment=NODE_ENV=production
# Frames go straight to KMS: no compositor, no Chromium, nothing to composite
# against. This is the whole point of the headless build.
Environment=GST_GL_WINDOW=surfaceless
Environment=GST_GL_PLATFORM=egl
# waylandsink cannot start without a compositor, and plain kmssink fails its
# first page flip with "Device or resource busy"; force-modesetting takes the
# CRTC properly. Both measured on a Pi 3B+.
Environment="LIVI_GST_SINK=kmssink force-modesetting=true"
# No cursor can be drawn over the video, so navigation is the phone's own focus
# ring driven by rotary ticks — which requires not announcing a touchscreen
# (patch 0006). The two settings only make sense together.
Environment=LIVI_AA_TOUCHSCREEN=0
# NO GStreamer registry pinning here, deliberately. It bought ~7 s of boot and
# cost a full evening: a registry primed externally (gst-inspect over SSH) and
# frozen with GST_REGISTRY_UPDATE=no fed gst-host broken element caps, and every
# video pipeline died with not-negotiated (-4) while probe, session and audio
# all looked healthy. If this is ever retried, the registry must be produced by
# livi-gst-host itself, in this unit's exact environment — and verified with a
# phone on screen before it is kept.
# Same idea for the 1 MB bundle: Node 22+ caches compiled bytecode, which is
# worth a second or so of a cold start on an A53.
Environment=NODE_COMPILE_CACHE=/var/cache/livi/node
# A wedged pipeline must not hold up a power-down on a bike.
TimeoutStopSec=10

# A cold boot leaves bluetoothd in a state where LIVI's helper registers its
# profiles but RFCOMM data never flows: phones connect and give up ("connection
# reset by peer", no WPP handshake). Seen after every hard power cut and on
# cold boots; a bluetoothd restart right before we start fixed it every single
# time, so do exactly that. "+" runs the step as root.
ExecStartPre=+-/usr/bin/systemctl try-restart bluetooth.service
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/node /opt/livi/livi-headless.cjs

# The unit is the product: if projection dies, bring it back rather than leaving
# a black screen on a bike.
Restart=always
RestartSec=3
# exit 42 is the app asking to be relaunched (app.relaunch in the shim).
SuccessExitStatus=0 42

StandardOutput=journal
StandardError=journal
SyslogIdentifier=livi-headless

# Give the projection loop priority over background housekeeping.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

[Install]
WantedBy=multi-user.target
