# livi-setup.env — firstrun.sh bunu /boot/firmware/livi-setup.env yolundan okur.
#
# Bu dosyayı livi-setup.env adıyla kopyalayıp doldurun ve kartın FAT boot
# bölümüne koyun. Gerçek dosya .gitignore'da — sırlar repoya girmez.

# Pi'nin ilk açılışta bağlanacağı Wi-Fi ağı (paket indirmek için)
WIFI_SSID="ev-agi-adi"
WIFI_PSK="wifi-sifresi"

# Pi kullanıcısının parola hash'i. Şununla üretin:
#   openssl passwd -6 'sizin-sifreniz'
LIVI_PW_HASH='$6$xxxxxxxxxxxxxxxx$yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy'

# Wi-Fi düzenleyici bölge (AP modu ve 5 GHz kanalları için önemli)
WIFI_COUNTRY="TR"
