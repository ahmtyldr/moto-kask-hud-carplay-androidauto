+/**
+ * Bundles the headless (no-Electron) LIVI appliance for plain Node.
+ *
+ * The whole trick is the `electron` alias: every import of 'electron' resolves
+ * to src/main/headless/electronShim.ts instead of the real runtime, so the
+ * existing TypeScript tree compiles and runs unchanged on Node. Nothing under
+ * src/main is edited for the headless build.
+ *
+ * Native addons (gst-video, crypto) stay external — they are prebuilt .node
+ * binaries loaded at runtime and must not be inlined.
+ */
+import { build } from 'esbuild'
+import { fileURLToPath } from 'node:url'
+import { dirname, join } from 'node:path'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const r = (p) => join(root, p)
+
+// Mirrors tsconfig.node.json paths.
+const alias = {
+  electron: r('src/main/headless/electronShim.ts'),
+  '@main': r('src/main'),
+  '@shared': r('src/main/shared'),
+  '@projection': r('src/main/services/projection'),
+  '@audio': r('src/main/audio/index.ts')
+}
+
+/**
+ * Vite lets source import files as strings with a `?raw` suffix; esbuild has no
+ * such notion, so resolve those to the plain file and load it as text.
+ */
+const rawSuffixPlugin = {
+  name: 'raw-suffix',
+  setup(b) {
+    b.onResolve({ filter: /\?raw$/ }, (args) => ({
+      path: join(args.resolveDir, args.path.replace(/\?raw$/, '')),
+      namespace: 'raw-file'
+    }))
+    b.onLoad({ filter: /.*/, namespace: 'raw-file' }, async (args) => {
+      const { readFile } = await import('node:fs/promises')
+      return { contents: await readFile(args.path, 'utf8'), loader: 'text' }
+    })
+  }
+}
+
+await build({
+  entryPoints: [r('src/main/headless/index.ts')],
+  bundle: true,
+  platform: 'node',
+  target: 'node24',
+  format: 'cjs',
+  outfile: r('out-headless/livi-headless.cjs'),
+  sourcemap: true,
+  // Prebuilt addons and their loaders resolve at runtime, never inline them.
+  // `usb` ships per-platform .node binaries and must be required, not bundled.
+  external: ['*.node', 'bindings', 'node-gyp-build', 'usb', '@node-usb/*'],
+  alias,
+  plugins: [rawSuffixPlugin],
+  loader: { '.b64': 'text' },
+  logLevel: 'info',
+  metafile: true,
+  banner: {
+    js: '/* LIVI headless appliance — no Electron, no renderer. */'
+  }
+})
+  .then((res) => {
+    const out = Object.entries(res.metafile.outputs).find(([f]) => f.endsWith('.cjs'))
+    if (out) console.log(`bundle: ${(out[1].bytes / 1024).toFixed(0)} KB`)
+  })
+  .catch((err) => {
+    console.error(err)
+    process.exit(1)
+  })
