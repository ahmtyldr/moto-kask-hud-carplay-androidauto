index 0000000..25caf6f
--- /dev/null
+++ b/src/main/headless/statusUi.ts
@@ -0,0 +1,155 @@
+/**
+ * Idle-screen manager: drives the LVGL status binary (livi-statusui).
+ *
+ * KMS allows a single display master, so the status screen may only live while
+ * no projection session holds the screen: show it at boot, kill it the moment
+ * video starts, bring it back when the session ends. The binary releases the
+ * DRM master simply by exiting, which is why hide() is a SIGTERM and not IPC.
+ *
+ * Lifecycle rides the renderer-event seam in index.ts. Verified on hardware
+ * (Pi 3B+, LIVI v8.3.0): every event arrives on the single channel
+ * 'projection-event' with a discriminating `type` field, and the video
+ * lifecycle signal is exactly
+ *
+ *     {"type":"projection","shown":true}    → video on screen: hide
+ *     {"type":"projection","shown":false}   → session gone: show again
+ *
+ * The screen is also started by livi-splash.service at boot, long before Node
+ * has parsed the bundle — that is worth ~6 s of black panel on a Pi 3. So this
+ * manager adopts whatever is already drawing rather than starting a second
+ * copy: two processes would fight over the single DRM master.
+ *
+ * If the binary is missing (or LIVI_STATUSUI=0) everything here is a no-op —
+ * the appliance must never fail because its idle screen is absent.
+ */
+import { execFileSync, spawn, type ChildProcess } from 'node:child_process'
+import { existsSync } from 'node:fs'
+
+const BIN = process.env.LIVI_STATUSUI_BIN ?? '/opt/livi/statusui/livi-statusui'
+
+/** Event types worth echoing onto the idle screen while it is up. */
+const RELAY_TYPES = new Set(['bluetoothPairedList', 'devices', 'transportState'])
+
+type ProjectionEvent = { type?: string; shown?: boolean; payload?: unknown }
+
+export class StatusUi {
+  private child: ChildProcess | null = null
+  private enabled = process.env.LIVI_STATUSUI !== '0' && existsSync(BIN)
+  private lastSpawn = 0
+  private stopping = false
+
+  constructor() {
+    if (!this.enabled && process.env.LIVI_STATUSUI !== '0') {
+      console.log(`[statusui] disabled: no binary at ${BIN}`)
+    }
+  }
+
+  show(): void {
+    if (!this.enabled || this.stopping || this.child) return
+    // Something is already on screen (livi-splash from boot, or a leftover):
+    // leave it be. hide() knows how to stop it.
+    if (this.externalRunning()) return
+    const now = Date.now()
+    if (now - this.lastSpawn < 2000) return // crash-loop guard
+    this.lastSpawn = now
+    // Two things must be true before this screen can actually appear, both
+    // learned the hard way on hardware (each alone still left a black panel):
+    //  1. gst-host keeps its DRM fd — and the master with it — after the
+    //     pipeline stops, so no other client can touch the display until the
+    //     process is gone. LIVI respawns it on the next video start
+    //     (gstHost.ts nulls the child on exit), so killing it here is safe.
+    //  2. kmssink leaves every plane without a framebuffer; LVGL's DRM driver
+    //     then flips onto an already-lit CRTC without a full modeset and shows
+    //     nothing. Cycling the connector (livi-display-reset, sudoers 011)
+    //     forces the first-boot path: full modeset, visible frames.
+    try {
+      execFileSync('/bin/sh', ['-c', 'pkill -x livi-gst-host 2>/dev/null; sleep 0.4'], {
+        stdio: 'ignore',
+        timeout: 3000
+      })
+    } catch {
+      /* none running */
+    }
+    try {
+      execFileSync('sudo', ['-n', '/usr/local/bin/livi-display-reset'], {
+        stdio: 'ignore',
+        timeout: 5000
+      })
+    } catch {
+      /* helper missing — the first boot still works without it */
+    }
+    const child = spawn(BIN, [], { stdio: ['pipe', 'inherit', 'inherit'] })
+    child.on('exit', () => {
+      if (this.child === child) this.child = null
+    })
+    child.on('error', (err: Error) => {
+      console.error(`[statusui] failed to start: ${err.message}`)
+      this.enabled = false
+      if (this.child === child) this.child = null
+    })
+    this.child = child
+  }
+
+  hide(): void {
+    const child = this.child
+    this.child = null
+    if (child) {
+      child.kill('SIGTERM')
+      return
+    }
+    // Not ours — the boot splash. Signal it by name; it releases the DRM master
+    // by exiting, which is what kmssink is waiting for.
+    try {
+      execFileSync('pkill', ['-x', 'livi-statusui'], { stdio: 'ignore' })
+    } catch {
+      /* nothing running */
+    }
+  }
+
+  private externalRunning(): boolean {
+    try {
+      execFileSync('pgrep', ['-x', 'livi-statusui'], { stdio: 'ignore' })
+      return true
+    } catch {
+      return false
+    }
+  }
+
+  /** One line of secondary text on the idle screen; trimmed, single line. */
+  message(text: string): void {
+    if (!this.child?.stdin?.writable) return
+    this.child.stdin.write(`msg ${text.replace(/\s+/g, ' ').trim().slice(0, 120)}\n`)
+  }
+
+  onEvent(channel: string, args: unknown[]): void {
+    if (channel !== 'projection-event') return
+    const ev = args[0] as ProjectionEvent | undefined
+    if (!ev || typeof ev !== 'object') return
+
+    if (ev.type === 'projection') {
+      if (ev.shown) this.hide()
+      else this.show()
+      return
+    }
+    // Session events arrive seconds before the video's own shown:true, and on a
+    // fast reconnect that head start is what lets the screen be released before
+    // kmssink calls set_caps — waiting for shown:true loses that race (seen on
+    // hardware: session + audio alive, video dead with "negotiation problem").
+    if (ev.type === 'session') {
+      if ((ev as { total?: number }).total === 0) this.show()
+      else this.hide()
+      return
+    }
+    if (ev.type && RELAY_TYPES.has(ev.type)) {
+      if (ev.type === 'devices' && Array.isArray(ev.payload) && ev.payload[0]) {
+        const d = ev.payload[0] as { name?: string; status?: string }
+        if (d.name) this.message(`${d.name}: ${d.status ?? ''}`)
+      }
+    }
+  }
+
+  stop(): void {
+    this.stopping = true
+    this.hide()
+  }
+}
